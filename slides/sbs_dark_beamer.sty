\definecolor{bgdark}{RGB}{15,15,20}
\definecolor{fgwhite}{RGB}{240,240,240}
\definecolor{accentcyan}{RGB}{0,255,255}
\definecolor{softgray}{RGB}{120,120,120}
\definecolor{darkgray}{RGB}{30,30,35}
\definecolor{codebg}{RGB}{20,20,25}
\definecolor{neonyellow}{RGB}{255,220,0}
\definecolor{neonpink}{RGB}{255,50,150}
\definecolor{neonorange}{RGB}{255,140,0}
\definecolor{neongreen}{RGB}{50,255,100}
\definecolor{neonblue}{RGB}{0,120,255}
\definecolor{customblue}{RGB}{0,150,255}
